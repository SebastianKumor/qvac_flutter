# Finds the native binaries for one target, like linux-x64: a local build from
# tool/worker if there is one, else the GitHub release zip, checked by SHA-256.
include("${CMAKE_CURRENT_LIST_DIR}/release.cmake")

macro(qvac_binaries target result)
  set(_local "${CMAKE_CURRENT_LIST_DIR}/../build_desktop/${target}")
  if(EXISTS "${_local}/worker.bundle")
    set(${result} "${_local}")
  else()
    set(_url "${QVAC_${target}_URL}")
    set(_sha "${QVAC_${target}_SHA256}")
    if(NOT _sha)
      message(FATAL_ERROR "qvac_flutter: no binaries for ${target}")
    endif()
    if(DEFINED ENV{QVAC_BINARIES_URL})
      set(_url "$ENV{QVAC_BINARIES_URL}")
    endif()
    # In the user's cache, so flutter clean doesn't throw away 100 MB.
    if(WIN32)
      set(_cache "$ENV{LOCALAPPDATA}/qvac_flutter")
    elseif(DEFINED ENV{XDG_CACHE_HOME})
      set(_cache "$ENV{XDG_CACHE_HOME}/qvac_flutter")
    else()
      set(_cache "$ENV{HOME}/.cache/qvac_flutter")
    endif()
    set(_dir "${_cache}/${_sha}")
    if(NOT EXISTS "${_dir}/worker.bundle")
      message(STATUS "qvac_flutter: downloading native binaries from ${_url}")
      file(DOWNLOAD "${_url}" "${_cache}/${_sha}.zip.part"
        EXPECTED_HASH SHA256=${_sha} TLS_VERIFY ON
        INACTIVITY_TIMEOUT 60 STATUS _status)
      list(GET _status 0 _code)
      if(NOT _code EQUAL 0)
        file(REMOVE "${_cache}/${_sha}.zip.part")
        message(FATAL_ERROR "qvac_flutter: download of ${_url} failed: ${_status}")
      endif()
      # Unpack next to it and rename, so a stopped build never leaves half a folder.
      file(REMOVE_RECURSE "${_cache}/${_sha}.tmp")
      file(ARCHIVE_EXTRACT INPUT "${_cache}/${_sha}.zip.part" DESTINATION "${_cache}/${_sha}.tmp")
      file(REMOVE "${_cache}/${_sha}.zip.part")
      file(REMOVE_RECURSE "${_dir}")
      file(RENAME "${_cache}/${_sha}.tmp" "${_dir}")
    endif()
    set(${result} "${_dir}")
  endif()
endmacro()
