# Finds the native binaries for one target, like linux-x64: a local build from
# tool/worker if there is one, else the GitHub release zip, checked by SHA-256.
include("${CMAKE_CURRENT_LIST_DIR}/release.cmake")
set(_QVAC_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")

function(qvac_binaries target result)
  set(local "${_QVAC_ROOT}/build_desktop/${target}")
  if(EXISTS "${local}/worker.bundle")
    set(${result} "${local}" PARENT_SCOPE)
    return()
  endif()
  set(url "${QVAC_${target}_URL}")
  set(sha "${QVAC_${target}_SHA256}")
  if(NOT sha)
    message(FATAL_ERROR "qvac_flutter: there are no binaries for ${target}")
  endif()
  if(DEFINED ENV{QVAC_BINARIES_URL})
    set(url "$ENV{QVAC_BINARIES_URL}")
  endif()
  # In the user's cache, so flutter clean doesn't throw away 100 MB.
  if(WIN32)
    set(cache "$ENV{LOCALAPPDATA}")
    if(NOT cache)
      set(cache "$ENV{USERPROFILE}/AppData/Local")
    endif()
    file(TO_CMAKE_PATH "${cache}/qvac_flutter" cache)
  elseif(DEFINED ENV{XDG_CACHE_HOME})
    set(cache "$ENV{XDG_CACHE_HOME}/qvac_flutter")
  else()
    set(cache "$ENV{HOME}/.cache/qvac_flutter")
  endif()
  set(dir "${cache}/${sha}")
  file(MAKE_DIRECTORY "${cache}")
  # Two builds at once (Debug and Release, or two apps) share the cache.
  file(LOCK "${cache}/${sha}.lock" GUARD FUNCTION TIMEOUT 1800)
  if(NOT EXISTS "${dir}/worker.bundle")
    message(STATUS "qvac_flutter: downloading native binaries from ${url}")
    file(DOWNLOAD "${url}" "${cache}/${sha}.zip.part"
      EXPECTED_HASH SHA256=${sha} TLS_VERIFY ON
      INACTIVITY_TIMEOUT 60 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${cache}/${sha}.zip.part")
      message(FATAL_ERROR "qvac_flutter: download of ${url} failed: ${status}")
    endif()
    # Unpack next to it and rename, so a stopped build never leaves half a folder.
    file(REMOVE_RECURSE "${cache}/${sha}.tmp")
    file(ARCHIVE_EXTRACT INPUT "${cache}/${sha}.zip.part" DESTINATION "${cache}/${sha}.tmp")
    file(REMOVE "${cache}/${sha}.zip.part")
    file(REMOVE_RECURSE "${dir}")
    file(RENAME "${cache}/${sha}.tmp" "${dir}" RESULT moved)
    if(NOT moved EQUAL 0)
      message(FATAL_ERROR "qvac_flutter: could not move the binaries to ${dir}: ${moved}")
    endif()
  endif()
  set(${result} "${dir}" PARENT_SCOPE)
endfunction()
